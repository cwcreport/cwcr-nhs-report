# Application
NEXT_PUBLIC_APP_NAME="CWCR-NHF Mentors Reporting Platform"
NEXT_PUBLIC_APP_PUBLIC_NAME="CWC Research Mentorship Portal"

# Maintenance Mode Configuration (503 Service Suspension)
# Set to "true", "1", or "yes" to suspend all active routes and show the 503 page
MAINTENANCE_MODE=false
# Optional custom maintenance message displayed to users
MAINTENANCE_MESSAGE="The CWC Research Mentorship Portal is currently undergoing scheduled maintenance and platform upgrades. All data, drafts, and records are completely safe. We will be back online shortly."
# Optional estimated completion time (e.g. "Today at 3:00 PM WAT" or ISO timestamp)
MAINTENANCE_UNTIL="Today at 3:00 PM (WAT)"
# Optional secret passkey to allow administrators to bypass maintenance mode (?bypass=<token>)
MAINTENANCE_BYPASS_TOKEN="super-secret-admin-token"
# Support contact email shown on the 503 page
MAINTENANCE_CONTACT_EMAIL="support@cwcr.ng"

# Authentication & Database
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/nhs-report?retryWrites=true&w=majority"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="nhs-mentor-report"

# SMTP Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CWCR-NHF Mentors Reporting <noreply@cwcr.ng>"
DIGEST_RECIPIENT_EMAILS=""

# Timezone & Integrations
TIMEZONE="Africa/Lagos"
CRON_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GEMINI_API_KEY=""
